// ==== PROGRAMA PRINCIPAL ====
public class ClinicaVeterinaria {
    public static void main(String[] args) {
        // Saludo IA
        IAHelper.saludar();

        // Crear cliente y paciente
        Cliente cliente = new Cliente("Ana López");
        Paciente mascota = new Paciente("Milo", "Gato", 2);

        // Crear atención
        Atencion atencion = FabricaAtencion.crear("consulta", cliente, mascota, new Date(), 30);

        // Crear cita
        Cita cita = new Cita(atencion, new Date());
        System.out.println("\nEstado inicial de la cita: " + cita.getEstadoNombre());

        // Avanzar estado
        cita.avanzarEstado();
        System.out.println("Estado tras confirmar: " + cita.getEstadoNombre());

        cita.avanzarEstado();
        System.out.println("Estado en curso: " + cita.getEstadoNombre());

        // Procesar atención (Template Method)
        atencion.procesarAtencion();

        cita.avanzarEstado();
        System.out.println("Estado final: " + cita.getEstadoNombre());

        // Calcular costo
        PoliticaCobro cobro = new PorTiempo(2.0); // Q2 por minuto
        double total = cobro.calcularCosto(atencion);
        System.out.println("\nCosto total de la atención: Q" + total);
    }
}

