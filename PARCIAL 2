// nivel 1

class InvalidChoiceException extends Exception {
    // excepción para entradas inválidas del jugador
    public InvalidChoiceException(String msg) { super(msg); }
}

class AttackMissedException extends Exception {
    //excepción para cuando un ataque falla por precisión
    public AttackMissedException(String msg) { super(msg); }
}

// =======================================================
//  INTERFAZ FUNCIONAL PARA LAS REGLAS POR DAÑO
// =======================================================
@FunctionalInterface
interface DamageRule {
    //la regla que calcula el daño final
    int computeDamage(Pokemon attacker, Pokemon defender, int baseDamage);
}

// =======================================================
// CLASE ATTACK (ENTIDAD DE DOMINIO)
// =======================================================
class Attack {
    private final String name;
    private final double accuracy; // 0.0 - 1.0
    private final int baseDamage;
    private final DamageRule rule;
    private final Random rnd = new Random();

    // parte del constructor simple
    public Attack(String name, double accuracy, int baseDamage, DamageRule rule) {
        this.name = name;
        this.accuracy = accuracy;
        this.baseDamage = baseDamage;
        this.rule = rule;
    }

    public String getName() { return name; }
    public double getAccuracy() { return accuracy; }
    public int getBaseDamage() { return baseDamage; }

    // nivel 2 viene siendo ejecutar ataque, puede lanzar AttackMissedException
    public int execute(Pokemon attacker, Pokemon defender) throws AttackMissedException {
        double roll = rnd.nextDouble();
        if (roll > accuracy) {
            // nivel 2: datos sobre: atacar y fallar
            throw new AttackMissedException(attacker.getSpecies() + " usó " + name + " y falló.");
        }
        // aplicar regla de daño
        int dmg = rule.computeDamage(attacker, defender, baseDamage);
        return Math.max(0, dmg);
    }

    @Override
    public String toString() {
        return String.format("%s (Acc: %.0f%%, Base: %d)", name, accuracy * 100, baseDamage);
    }
}

// =======================================================
// clase pokemon
// =======================================================
abstract class Pokemon {
    protected String trainerName; // quien lo posee (Jugador/CPU o nombre real)
    protected String species;     // Charmander, Squirtle, ...
    protected int maxHp;
    protected int currentHp;
    protected int level;
    protected final List<Attack> attacks = new ArrayList<>();

    // la base
    public Pokemon(String trainerName, String species, int maxHp, int level) {
        this.trainerName = trainerName;
        this.species = species;
        this.maxHp = maxHp;
        this.currentHp = maxHp;
        this.level = level;
    }

    public String getName() { return trainerName + "'s " + species; }
    public String getSpecies() { return species; }
    public int getMaxHp() { return maxHp; }
    public int getCurrentHp() { return currentHp; }
    public boolean isFainted() { return currentHp <= 0; }
    public List<Attack> getAttacks() { return Collections.unmodifiableList(attacks); }

    // datos sobre recibir daño sin bajar de 0 de hp
    public void receiveDamage(int dmg) {
        currentHp = Math.max(0, currentHp - dmg);
    }

    // reiniciar el HP (si se necesita)
    public void healFull() {
        currentHp = maxHp;
    }

    // cada subclase define sus ataques
    protected abstract void initAttacks();

    @Override
    public String toString() {
        return String.format("%s (%s) HP: %d/%d", trainerName, species, currentHp, maxHp);
    }
}

