class Charmander extends Pokemon {
    public Charmander(String trainerName) {
        super(trainerName, "Charmander", 80, 5);
        initAttacks();
    }

    @Override
    protected void initAttacks() {
        // reglas con lambdas para daño según tipo de pokemon
        DamageRule simple = (a, d, b) -> b + a.level * 2;
        DamageRule fire = (a, d, b) -> {
            int dmg = b + a.level * 3;
            // NOVATO - nivel 3: ventaja contra Bulbasaur
            if ("Bulbasaur".equalsIgnoreCase(d.getSpecies())) dmg *= 2;
            return dmg;
        };

        attacks.add(new Attack("Arañazo", 0.95, 6, simple));
        attacks.add(new Attack("Ascuas", 0.9, 10, fire));
        attacks.add(new Attack("Llamarada", 0.7, 20, fire));
    }
}

